DATABASE_URL=sqlite:///./middleware.db
# For Groq: https://api.groq.com/openai/v1, llama-3.1-8b-instant, false
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_JSON_SCHEMA=true
LLM_API_KEY=
# Fail instead of silently using rules when the key is missing in real-service mode.
LLM_REQUIRED=false
CHRONOS_MODEL=autogluon/chronos-bolt-small
CHRONOS_DEVICE=cpu
CHRONOS_CACHE_DIR=.cache/huggingface
CHRONOS_BATCH_SIZE=32
FORECAST_MODE=offline
FORECAST_STRATEGY=adaptive
DEPLOYMENT_MODE=local
JOB_QUEUE_SIZE=3
JOB_DIRECTORY=.cache/jobs
# Set before exposing the API outside localhost.
API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
